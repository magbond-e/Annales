# ==============================================================================
# Annale229 (MBH) — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles
# ⚠️  Ne jamais committer .env.local dans git
# ==============================================================================

# ── Authentification NextAuth.js ───────────────────────────────────────────────
# Générer un secret fort : openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3005

# ── Google Sign-In (connexion étudiants) ──────────────────────────────────────
# Créer un projet Google (console.cloud.google.com), activer Google Sign-In,
# créer un credential OAuth "Application Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Administrateurs ───────────────────────────────────────────────────────────
# Email de l'administrateur principal (accès à /admin)
ADMIN_EMAIL=
# Admins supplémentaires séparés par virgule (optionnel)
ADMIN_EMAILS=
# Super-admin fondateur (ne peut jamais être rétrogradé)
SUPER_ADMIN_EMAIL=

# ── Neon PostgreSQL (base de données) ─────────────────────────────────────────
# Créer un compte sur https://neon.tech (gratuit, sans carte bancaire)
# Créer un projet → onglet "Dashboard" → copier "Connection string"
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_DATA_API_URL=

# ── Cloudinary (stockage fichiers PDF/images) ─────────────────────────────────
# Créer un compte sur https://cloudinary.com (gratuit, sans carte bancaire)
# Dashboard → "Product Environment" → copier Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Neon Object Storage S3 (stockage miroir S3-compatible) ───────────────────
# Dashboard Neon → "Storage" → créer un bucket → copier les credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
